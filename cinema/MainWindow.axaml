<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
        x:Class="cinema.MainWindow"
        Title="Cinema Booking"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BoxShadow" Value="0 4 8 0 rgba(0,0,0,0.4)"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10 20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Styles>

    <Grid Background="#1C1C1C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Classes="card" MaxWidth="500" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="15">
                <TextBlock Text="Rezervace vstupenek" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 10"/>

                <TextBlock Text="Vyberte film:" FontWeight="SemiBold"/>
                <ComboBox Name="FilmComboBox" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Duna: Část druhá"/>
                    <ComboBoxItem Content="Oppenheimer"/>
                    <ComboBoxItem Content="Interstellar"/>
                </ComboBox>

                <Border BorderThickness="1" BorderBrush="#444" CornerRadius="5" Padding="10" Margin="0 10 0 0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Typ sedadla:" FontWeight="SemiBold"/>
                        <RadioButton Name="StandardRadioButton" Content="Standard" GroupName="SeatType" IsChecked="True"/>
                        <RadioButton Name="PremiumRadioButton" Content="Premium" GroupName="SeatType"/>
                    </StackPanel>
                </Border>

                <Border BorderThickness="1" BorderBrush="#444" CornerRadius="5" Padding="10" Margin="0 10 0 0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Doplňky:" FontWeight="SemiBold"/>
                        <CheckBox Name="PopcornCheckBox" Content="Popcorn"/>
                        <CheckBox Name="DrinkCheckBox" Content="Nápoj"/>
                        <CheckBox Name="GlassesCheckBox" Content="3D brýle"/>
                    </StackPanel>
                </Border>

                <Button Name="ShowReservationButton" Content="Zobrazit rezervaci" Classes="primary" Margin="0 20 0 0" Click="ShowReservationButton_OnClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
