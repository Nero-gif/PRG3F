<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="testLibrary.SummaryWindow"
        Title="SummaryWindow">
    <StackPanel>
        <TextBlock Name="BookHeader" Text="vybraná kniha" FontWeight="Bold"/>
        <TextBlock Name="BookSelected" Text=""/>
        <TextBlock Name="LenghtHeader" Text="doba" FontWeight="Bold"/>
        <TextBlock Name="Lenght" Text=""/>
        <TextBlock Name="OptionsHeader" Text="vybrané možnosti" FontWeight="Bold"/>
        <TextBlock Name="Options" Text=""/>
    </StackPanel>
</Window>