<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CookieClicker.ShopWindow"
        Title="Shop"
        Background="#2B2B2B">

    <Window.Styles>
        <!-- Style for the Border, which now acts as the card -->
        <Style Selector="Border.ShopItem">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="BorderBrush" Value="#505050"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BoxShadow" Value="0 2 10 0 #1A000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0.1"/>
                </Transitions>
            </Setter>
        </Style>
        
        <!-- PointerOver effect for the Border -->
        <Style Selector="Border.ShopItem:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
            <Setter Property="BoxShadow" Value="0 4 15 0 #33000000"/>
        </Style>
        
        <!-- Make button transparent and centered -->
        <Style Selector="Border.ShopItem > Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- Text styles for dark mode -->
        <Style Selector="TextBlock.Title">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
        </Style>
        <Style Selector="TextBlock.Info">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B0B0B0"/>
        </Style>
        <Style Selector="TextBlock.ShopCookieCount">
            <Setter Property="Background" Value="#343434"/>
            <Setter Property="Foreground" Value="#F4F4F4"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,*,*" RowSpacing="20" ColumnSpacing="20" Margin="20">

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Name="CookieCount"
                   Text="0 Cookies"
                   Classes="ShopCookieCount"/>

        <!-- CpC Item -->
        <Border Grid.Row="1" Grid.Column="0" Classes="ShopItem">
            <Button Name="CpC" Click="CpC_OnClick">
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <Image Source="avares://CookieClicker/Images/coursor.png" Width="60" Height="60" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Cursor Upgrade" Classes="Title"/>
                        <TextBlock Name="CpCLevel" Text="Level: 0" Classes="Info"/>
                        <TextBlock Name="CpCPrice" Text="Price: 0" Classes="Info"/>
                        <TextBlock Name="CpCValue" Text="Value: 0" Classes="Info"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Border>

        <!-- CpS Item -->
        <Border Grid.Row="1" Grid.Column="1" Classes="ShopItem">
            <Button Name="CpS" Click="CpS_OnClick">
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <Image Source="avares://CookieClicker/Images/timer.png" Width="60" Height="60" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Auto-Clicker" Classes="Title"/>
                        <TextBlock Name="CpSLevel" Text="Level: 0" Classes="Info"/>
                        <TextBlock Name="CpSPrice" Text="Price: 0" Classes="Info"/>
                        <TextBlock Name="CpSValue" Text="Value: 0" Classes="Info"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Border>

        <!-- CpCmultiplicator Item -->
        <Border Grid.Row="2" Grid.Column="0" Classes="ShopItem">
            <Button Name="CpCmultiplicator" Click="CpCmultiplicator_OnClick">
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <Image Source="avares://CookieClicker/Images/grandma.jpeg" Width="60" Height="60" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Grandma Power" Classes="Title"/>
                        <TextBlock Name="CpCMultiplicatorLevel" Text="Level: 0" Classes="Info"/>
                        <TextBlock Name="CpCMultiplicatorPrice" Text="Price: 0" Classes="Info"/>
                        <TextBlock Name="CpCMultiplicatorValue" Text="Value: 0" Classes="Info"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Border>

        <!-- CpSmultiplicator Item -->
        <Border Grid.Row="2" Grid.Column="1" Classes="ShopItem">
            <Button Name="CpSmultiplicator" Click="CpSmultiplicator_OnClick">
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <Image Source="avares://CookieClicker/Images/factory.png" Width="60" Height="60" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Factory Boost" Classes="Title"/>
                        <TextBlock Name="CpSMultiplicatorLevel" Text="Level: 0" Classes="Info"/>
                        <TextBlock Name="CpSMultiplicatorPrice" Text="Price: 0" Classes="Info"/>
                        <TextBlock Name="CpSMultiplicatorValue" Text="Value: 0" Classes="Info"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Border>

    </Grid>
</Window>
