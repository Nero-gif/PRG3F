<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="400"
        x:Class="schoolTrip.SummaryWindow"
        Title="Souhrn přihlášky"
        Background="#252525">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBlock.Header">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style Selector="TextBlock.Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#b0b0b0"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="8" Background="#2d2d2d" Padding="30" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450">
        <StackPanel Spacing="15">
            <TextBlock Text="Souhrn přihlášky" Classes="Header"/>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,10,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Jméno:" Classes="Label" Margin="0,0,15,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Name="StudentNameTextBlock"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cíl:" Classes="Label" Margin="0,0,15,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Name="DestinationTextBlock"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Doprava:" Classes="Label" Margin="0,0,15,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Name="TransportTextBlock"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Služby:" Classes="Label" Margin="0,0,15,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Name="ServicesTextBlock" TextWrapping="Wrap"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
