<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="schoolTrip.MainWindow"
        Title="Přihláška na školní výlet"
        Background="#252525">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#3e3e3e"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#3e3e3e"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#005A9E"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="8" Background="#2d2d2d" Padding="30" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450">
        <StackPanel Spacing="15">
            <TextBlock Text="Přihláška na školní výlet"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Jméno studenta -->
            <StackPanel Spacing="5">
                <TextBlock Text="Jméno studenta:"/>
                <TextBox Name="StudentNameTextBox" Watermark="Zadejte své jméno"/>
            </StackPanel>

            <!-- Cíl výletu -->
            <StackPanel Spacing="5">
                <TextBlock Text="Cíl výletu:"/>
                <ComboBox Name="DestinationComboBox" PlaceholderText="Vyberte cíl">
                    <ComboBoxItem Content="Praha"/>
                    <ComboBoxItem Content="Brno"/>
                    <ComboBoxItem Content="Ostrava"/>
                </ComboBox>
            </StackPanel>

            <!-- Doprava -->
            <StackPanel Spacing="5">
                <TextBlock Text="Doprava:"/>
                <RadioButton Name="BusRadioButton" Content="Autobus" GroupName="Transport"/>
                <RadioButton Name="TrainRadioButton" Content="Vlak" GroupName="Transport"/>
                <RadioButton Name="OwnTransportRadioButton" Content="Vlastní doprava" GroupName="Transport"/>
            </StackPanel>

            <!-- Doplňkové služby -->
            <StackPanel Spacing="5">
                <TextBlock Text="Doplňkové služby:"/>
                <CheckBox Name="LunchCheckBox" Content="Objednat oběd"/>
                <CheckBox Name="InsuranceCheckBox" Content="Sjednat pojištění"/>
                <CheckBox Name="TourCheckBox" Content="Účastnit se komentované prohlídky"/>
            </StackPanel>

            <!-- Odeslat -->
            <Button Name="SubmitButton" Content="Odeslat přihlášku" Margin="0,20,0,0" Click="SubmitButton_OnClick"/>
        </StackPanel>
    </Border>
</Window>
